<!DOCTYPE html>
<html lang="{{@site.locale}}">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title page=(t " (Page %)")}}</title>
    {{!-- One author, so the author archive is the index with a different H1. --}}
    {{#is "author"}}<meta name="robots" content="noindex">{{/is}}

    <link rel="stylesheet" href="{{asset "built/screen.css"}}">

    {{ghost_head}}
</head>

<body class="{{body_class}}{{{block "body_class"}}} is-head-left-logo">
<div class="site">

    <header id="gh-head" class="gh-head gh-outer">
        <div class="gh-head-inner">
            <div class="gh-head-brand">
                <div class="gh-head-brand-wrapper">
                    {{!-- The image is the wordmark. The site title is never set in type. --}}
                    <a class="gh-head-logo" href="{{@site.url}}">
                        <picture>
                            <source srcset="{{asset "images/lanterns-logo_white.png"}}" media="(prefers-color-scheme: dark)">
                            <img src="{{asset "images/lanterns-logo_black.png"}}" alt="{{@site.title}}" width="1500" height="252">
                        </picture>
                    </a>
                </div>
                <button class="gh-burger" aria-label="{{t "Toggle menu"}}" aria-expanded="false" aria-controls="gh-head-menu"></button>
            </div>

            <nav class="gh-head-menu" id="gh-head-menu" aria-label="Main">
                {{navigation}}
            </nav>

            <div class="gh-head-actions">
                {{#if @site.members_enabled}}
                    <div class="gh-head-members">
                        {{#unless @member}}
                            {{#unless @site.members_invite_only}}
                                <a class="gh-head-link" href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a>
                                <a class="gh-head-btn gh-btn gh-primary-btn" href="#/portal/signup" data-portal="signup">{{@custom.subscribe_button}}</a>
                            {{else}}
                                <a class="gh-head-btn gh-btn gh-primary-btn" href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a>
                            {{/unless}}
                        {{else}}
                            <a class="gh-head-btn gh-btn gh-primary-btn" href="#/portal/account" data-portal="account">{{t "Account"}}</a>
                        {{/unless}}
                    </div>
                {{/if}}
            </div>
        </div>
    </header>

    <div class="site-content">
        {{{body}}}
    </div>

    <footer class="gh-foot{{#unless @site.secondary_navigation}} no-menu{{/unless}} gh-outer">
        <div class="gh-foot-inner gh-inner">
            <div class="gh-copyright">
                <a href="https://lanterns.dev/">lanterns.dev</a> · © {{date format="YYYY"}}
            </div>
            <div class="gh-foot-center">
                <div class="gh-social-links">
                    {{#social_accounts @site}}
                        <a href="{{href}}" target="_blank" rel="noopener" aria-label="{{name}}">
                            {{#> (concat "icons/" type)}}
                                {{!-- Fallback when no per-platform icon partial exists --}}
                                <span>{{name}}</span>
                            {{/undefined}}
                        </a>
                    {{/social_accounts}}
                    {{!-- GitHub is not one of Ghost Admin's social types, so the link lives here. --}}
                    <a href="https://github.com/Lanterns-Works" target="_blank" rel="noopener" aria-label="GitHub">{{> "icons/github"}}</a>
                </div>
                {{#if @site.secondary_navigation}}
                    <nav class="gh-foot-menu">
                        {{navigation type="secondary"}}
                    </nav>
                {{/if}}
            </div>
        </div>
    </footer>

</div>

{{#is "post, page"}}
    {{> "pswp"}}
{{/is}}

<script src="{{asset "built/main.min.js"}}"></script>

{{ghost_foot}}

</body>
</html>
