<!DOCTYPE html>
<html lang="{{@site.locale}}">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title page=(t " (Page %)")}}</title>
    {{!-- One author, so the author archive is the index with a different H1; the intro page is
         the index's own intro. Neither wants indexing. --}}
    {{#is "author"}}<meta name="robots" content="noindex">{{/is}}
    {{#is "page"}}{{#match post.slug @custom.intro_page}}<meta name="robots" content="noindex">{{/match}}{{/is}}

    <link rel="stylesheet" href="{{asset "built/screen.css"}}">

    {{ghost_head}}
</head>

{{!-- Over the home-page hero (partials/hero.hbs) the header is the shared CSS's transparent variant. --}}
<body class="{{body_class}}{{{block "body_class"}}} is-head-left-logo{{#is "home"}}{{#if @site.cover_image}} is-head-transparent{{/if}}{{/is}}">
<div class="site">

    <header id="gh-head" class="gh-head gh-outer">
        <div class="gh-head-inner">
            <div class="gh-head-brand">
                {{!-- The wordmark: the image, never the title as text, and the way back to the lantern
                     site. Beside it Admin's primary menu (two links, in the bar on every width; no
                     drawer). No Sign in or Subscribe up here (Maria, 2026-09-12): the index carries
                     the subscribe form and the footer the sign-in (partials/member-link.hbs). --}}
                <a class="gh-head-logo" href="https://lanterns.dev/" aria-label="{{@custom.home_link_label}}">
                    <picture>
                        {{!-- Over the hero the wordmark is white in both schemes: a source with no media query, ahead of the dark-scheme one. --}}
                        {{#is "home"}}{{#if @site.cover_image}}<source srcset="{{asset "images/lanterns-logo_white.png"}}">{{/if}}{{/is}}
                        <source srcset="{{asset "images/lanterns-logo_white.png"}}" media="(prefers-color-scheme: dark)">
                        <img src="{{asset "images/lanterns-logo_black.png"}}" alt="{{@site.title}}" width="1500" height="252">
                    </picture>
                </a>
            </div>

            <nav class="gh-head-menu" id="gh-head-menu" aria-label="Main">
                {{navigation}}
            </nav>
        </div>
    </header>

    <div class="site-content">
        {{{body}}}
    </div>

    <footer class="gh-foot gh-outer">
        {{!-- One line in the bottom-right corner, as on the lantern site: the link home, the year, the
             member link, then the icons. Admin's secondary menu is not rendered (Maria, 2026-09-12). --}}
        <div class="gh-foot-inner gh-inner">
            <a href="https://lanterns.dev/">lanterns.dev</a> · © {{date format="YYYY"}}
            {{> "member-link"}}
            <span class="gh-social-links">
                {{#social_accounts @site}}
                    <a href="{{href}}" target="_blank" rel="noopener" aria-label="{{name}}">
                        {{#> (concat "icons/" type)}}
                            {{!-- Fallback when no per-platform icon partial exists --}}
                            <span>{{name}}</span>
                        {{/undefined}}
                    </a>
                {{/social_accounts}}
                {{!-- GitHub is not one of Ghost Admin's social types, so the link lives here. --}}
                <a href="https://github.com/Lanterns-Works" target="_blank" rel="noopener" aria-label="GitHub">{{> "icons/github"}}</a>
            </span>
        </div>
    </footer>

</div>

{{#is "post, page"}}
    {{> "pswp"}}
{{/is}}

<script src="{{asset "built/main.min.js"}}"></script>

{{ghost_foot}}

</body>
</html>
