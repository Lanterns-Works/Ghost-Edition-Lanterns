{{!-- The member link in the footer line. Signed out: "Sign in", which opens the one-field form in
     a <dialog> (main.js), so nothing on the page moves; the form sends Ghost's sign-in link by
     email (data-members-form="signin"), no Portal popup. Signed in: "Sign out", Ghost's own
     attribute. The form reuses the subscribe form's classes, so its loading, success and error
     states and the focus move in main.js come for free. --}}
{{#if @site.members_enabled}}
    {{#if @member}}
        <a class="member-link" href="javascript:" data-members-signout>{{@custom.signout_link}}</a>
    {{else}}
        <button class="member-link button-text" type="button" data-signin-open>{{@custom.signin_link}}</button>
        <dialog class="signin" id="signin" aria-labelledby="signin-label">
            <div class="signin-inner">
                <form class="subscribe" data-members-form="signin">
                    <label class="subscribe-label" id="signin-label" for="signin-email">{{@custom.signin_label}}</label>
                    <div class="subscribe-row">
                        <input class="subscribe-input" id="signin-email" type="email" name="email" data-members-email placeholder="{{@custom.subscribe_placeholder}}" autocomplete="email" aria-describedby="signin-error" required autofocus>
                        <button class="subscribe-button" type="submit">
                            <span class="default">{{@custom.signin_button}}</span>
                            <span class="subscribe-sending">{{@custom.subscribe_sending}}</span>
                        </button>
                    </div>
                    <p class="subscribe-success" role="status" tabindex="-1">{{@custom.signin_success}}</p>
                    <p class="subscribe-error" id="signin-error" role="alert" data-members-error></p>
                </form>
                <button class="signin-close button-text" type="button" data-signin-close>{{@custom.signin_close}}</button>
            </div>
        </dialog>
    {{/if}}
{{/if}}
