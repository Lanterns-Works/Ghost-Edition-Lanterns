<article class="feed {{post_class}}">
    <h2 class="feed-title"><a href="{{url}}">{{title}}</a></h2>
    <time class="feed-date" datetime="{{date format="YYYY-MM-DD"}}">{{date published_at format="D MMMM YYYY"}}</time>
    {{#if excerpt}}
        <p class="feed-excerpt">{{excerpt words="40"}}</p>
    {{/if}}
</article>
