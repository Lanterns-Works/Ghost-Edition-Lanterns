{{#match pages ">" 1}}
<div class="gh-canvas">
    <nav class="pagination" aria-label="Pages">
        {{#if prev}}<a class="pagination-newer" href="{{page_url prev}}" rel="prev">← Newer essays</a>{{/if}}
        {{#if next}}<a class="pagination-older" href="{{page_url next}}" rel="next">Older essays →</a>{{/if}}
    </nav>
</div>
{{/match}}
