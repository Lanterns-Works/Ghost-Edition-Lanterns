{{!-- Our own subscribe form: Ghost's data-members-form handles the request and toggles
     loading / success / error on the form. Portal stays as the fallback modal. --}}
{{#if @site.members_enabled}}
{{#unless @site.members_invite_only}}
{{#unless @member}}
<form class="subscribe" data-members-form="subscribe">
    <label class="subscribe-label" for="subscribe-email">Get new essays by email.</label>
    <div class="subscribe-row">
        <input class="subscribe-input" id="subscribe-email" type="email" name="email" data-members-email placeholder="Your email address" autocomplete="email" required>
        <button class="subscribe-button" type="submit">
            <span class="default">{{t "Subscribe"}}</span>
            <span class="subscribe-sending">Sending…</span>
        </button>
    </div>
    <p class="subscribe-success">Check your email to confirm.</p>
    <p class="subscribe-error" data-members-error></p>
</form>
{{/unless}}
{{/unless}}
{{/if}}
