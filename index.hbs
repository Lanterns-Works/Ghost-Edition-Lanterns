{{!< default}}

<main class="site-main">

    {{#is "paged"}}{{else}}
    <header class="feed-header gh-canvas">
        {{!-- The intro is a Ghost page, so it is written in the editor: the one whose slug is the
             intro_page theme setting (Design & branding). No such page, no intro. --}}
        {{#if @custom.intro_page}}
            {{#get "pages" filter="slug:{{@custom.intro_page}}" limit="1"}}
                {{#foreach pages}}{{content}}{{/foreach}}
            {{/get}}
        {{/if}}
        {{> "subscribe"}}
    </header>
    {{/is}}

    <div class="post-feed gh-feed gh-canvas">
        {{#foreach posts}}
            {{> "loop"}}
        {{/foreach}}
    </div>

    {{> "pages-nav"}}

</main>
