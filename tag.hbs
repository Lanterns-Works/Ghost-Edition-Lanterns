{{!< default}}

<main class="site-main">

    {{#tag}}
    <header class="feed-header gh-canvas">
        <h1 class="feed-header-title">{{name}}</h1>
        {{#if description}}<p>{{description}}</p>{{/if}}
    </header>
    {{/tag}}

    <div class="post-feed gh-feed gh-canvas">
        {{#foreach posts}}
            {{> "loop"}}
        {{/foreach}}
    </div>

    {{pagination}}

</main>
