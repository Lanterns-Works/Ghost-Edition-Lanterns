# Copy to dev/.env (gitignored) to preview the theme against the live site: `pnpm preview`
# pulls its settings, posts and pages into the local rig. The key comes from Ghost Admin →
# Settings → Integrations → Add custom integration → Admin API key. Read-only use; nothing is
# ever written to the live site.
LANTERNS_GHOST_URL=https://essays.lanterns.dev
LANTERNS_GHOST_ADMIN_KEY=paste-the-admin-api-key-here
